rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /apps/{appId} {
      // Public store catalog: anyone can browse applications and games
      allow read: if true;
      allow write: if true;
    }

    match /categories/{categoryId} {
      // Public categories: anyone can browse categories
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /downloads/{downloadId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
